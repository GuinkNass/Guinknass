{
  "name": "guinknass-studio-13point",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && node -e \"if(process.env.DATABASE_URL && !process.env.DATABASE_URL.includes('sua_senha')){try{require('child_process').execSync('npx prisma db push --accept-data-loss',{stdio:'inherit'})}catch(e){console.warn('DB Push aviso:',e.message)}}\" && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "googleapis": "^144.0.0",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2"
  }
}
